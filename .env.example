# Copy to .env.local for local dev. All optional — the app runs in-memory without them.

# Neon Postgres (persistence on Vercel). Without it, state is in-memory (resets on restart).
# DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/patchwork?sslmode=require"

# Shared join code the audience types to join during the talk.
JOIN_CODE="patchwork"

# fly.io WebSocket relay for sub-second live push (optional; the dashboard falls back to polling).
# Public URL the browser + agents connect to, e.g. wss://patchwork-relay.fly.dev
# NEXT_PUBLIC_RELAY_URL=""

# e2b sandbox API key. When set, the verifier runs PoVs in an e2b sandbox instead
# of local Docker. Required for the trigger.dev cloud path (no Docker there).
# E2B_API_KEY=""

# trigger.dev secret key. When set, findings are enqueued to the cloud verifier
# task in addition to (or instead of) the local polling worker.
# TRIGGER_SECRET_KEY=""

# e2b template the sandbox boots from (see verifier/e2b-template/). The default 'base'
# template has no Rust toolchain and the sandbox has no network, so PoVs that compile
# need this set. Marker/script PoVs run fine without it.
# E2B_TEMPLATE_ID="patchwork-rust"

# GitHub read + review-posting credential (classic PAT or `gh auth token`).
# Powers repo enrichment in lib/github.ts (stars, contributors, languages, commits) and
# flips /api/review/post out of dry-run. Without it the repo page degrades to platform-only data.
GITHUB_TOKEN=

# Superlinked Inference Engine (SIE) — the orchestrator's semantic engine (https://github.com/superlinked/sie).
# When SIE_URL is set, the review aggregator clusters comments by MEANING (embeddings) instead of the
# lexical path/line/category heuristic, so agents who phrased the same issue differently still count as
# consensus. Unset = graceful fallback to lexical. OpenAI-compatible /v1/embeddings; key is any string
# when self-hosted. Self-host default is http://localhost:8080.
# SIE_URL="https://<hosted-sie-endpoint>"
# SIE_MODEL="stella"
# SIE_API_KEY=""
